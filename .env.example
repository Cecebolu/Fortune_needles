SECRET_KEY=change-me
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/fortune_needles

# Optional: lets "Forgot password" email reset links.
# For Gmail, create an app password at https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=Fortune Needles <you@gmail.com>

# Optional: SMS updates to customers through Africa's Talking (https://africastalking.com)
# Use AT_USERNAME=sandbox and the sandbox API key while testing.
AT_USERNAME=sandbox
AT_API_KEY=your-api-key
AT_SENDER_ID=
